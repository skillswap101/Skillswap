import dotenv from 'dotenv';
dotenv.config();
import stripeRouter from './stripe.js';

import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import { authenticateUser } from './middleware/auth.js';
import { releaseEscrowFunds } from './services/escrowService.js';
import { processMpesaCallback } from './services/mpesaService.js';
import { initiateStkPush } from './services/darajaService.js';

const app = express();

app.use(helmet());
app.use(cors());
// Mount Stripe routes
app.use(stripeRouter);

app.use(express.json());

// Health check endpoint
app.get('/health', (req, res) => {
  res.status(200).json({ status: 'healthy', timestamp: new Date().toISOString() });
});

// Secure Escrow Release Endpoint
app.post('/api/v1/escrow/:escrowId/release', authenticateUser, async (req, res) => {
  try {
    const { escrowId } = req.params;
    const requesterUid = req.user.uid;

    const result = await releaseEscrowFunds(escrowId, requesterUid);
    return res.status(200).json(result);
  } catch (error) {
    console.error('Escrow release error:', error.message);
    return res.status(400).json({ error: error.message });
  }
});

// M-Pesa STK Push Trigger Route
app.post('/api/v1/mpesa/stkpush', authenticateUser, async (req, res) => {
  try {
    const { phoneNumber, amount, accountReference, transactionDesc, escrowId } = req.body;
    const userId = req.user.uid;

    if (!phoneNumber || !amount) {
      return res.status(400).json({ error: 'Phone number and amount are required' });
    }

    const result = await initiateStkPush({
      phoneNumber,
      amount,
      accountReference,
      transactionDesc,
      escrowId,
      userId,
    });

    return res.status(200).json(result);
  } catch (error) {
    console.error('STK Push route error:', error.message);
    return res.status(400).json({ error: error.message });
  }
});

// M-Pesa Daraja Webhook Callback Endpoint
app.post('/api/v1/mpesa/callback', async (req, res) => {
  try {
    console.log('📥 Received M-Pesa Callback Payload:', JSON.stringify(req.body));
    await processMpesaCallback(req.body);
    return res.status(200).json({ ResultCode: 0, ResultDesc: 'Accepted successfully' });
  } catch (error) {
    console.error('M-Pesa callback handling error:', error.message);
    return res.status(200).json({ ResultCode: 0, ResultDesc: 'Received with errors' });
  }
});

const PORT = process.env.PORT || 5000;
app.listen(PORT, () => {
  console.log(`🚀 SkillSwap 5.0 Server running on port ${PORT}`);
});
