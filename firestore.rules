rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasField(data, field) {
      return field in data;
    }

    function isParticipant(data) {
      return signedIn()
        && hasField(data, "participantIds")
        && request.auth.uid in data.participantIds;
    }

    function validTwoPartyParticipants(data) {
      return hasField(data, "participantIds")
        && data.participantIds.size() == 2;
    }

    function validProposalParticipants(data) {
      return validTwoPartyParticipants(data)
        && hasField(data, "senderId")
        && hasField(data, "recipientId")
        && data.senderId in data.participantIds
        && data.recipientId in data.participantIds
        && data.senderId != data.recipientId;
    }

    function validSessionParticipants(data) {
      return validTwoPartyParticipants(data)
        && hasField(data, "mentorId")
        && hasField(data, "learnerId")
        && data.mentorId in data.participantIds
        && data.learnerId in data.participantIds
        && data.mentorId != data.learnerId;
    }

    function validMessageParticipants(data) {
      return validTwoPartyParticipants(data)
        && hasField(data, "senderId")
        && hasField(data, "recipientId")
        && data.senderId in data.participantIds
        && data.recipientId in data.participantIds
        && data.senderId != data.recipientId;
    }

    match /users/{uid} {
      // Previously any signed-in user could read ANY other user's full
      // document - including email, phone, and exact credit balance,
      // none of which are actually needed anywhere in the app: every
      // place that displays "another user's" info (skill cards, session
      // participants, proposal sender/recipient) already gets it from
      // fields denormalized directly onto that Skill/Session/Proposal
      // document, confirmed by an exhaustive search - nothing in the
      // client ever does a live cross-user read of users/{uid}. Tightened
      // to owner-only with no loss of functionality.
      allow read: if isOwner(uid);

      // The owner could previously write ANY field on their own document
      // via updateUserProfile - including timeCredits,
      // escrowLockedCredits, hoursTaught, rating, badges, etc. This
      // undermined the entire server-authoritative credit/escrow system
      // built elsewhere: a user didn't need to find a server bug at all,
      // they could just call updateUserProfile({ timeCredits: 999999 })
      // directly since they legitimately own that document. Now only
      // these specific profile-display fields may ever change from the
      // client; everything financial/reputation-related can only be
      // changed by the Admin SDK (server), which bypasses these rules
      // entirely and is unaffected by this allowlist.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'name', 'avatar', 'bio', 'location', 'title', 'phone',
               'skillsOffered', 'skillsDesired', 'skillsNeeded', 'skillsWanted',
               'responseTime', 'updatedAt', 'id'
             ]);

      allow create: if isOwner(uid);
      allow delete: if false;
    }

    match /skills/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /proposals/{id} {
      allow read: if isParticipant(resource.data)
        && validProposalParticipants(resource.data);

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && validProposalParticipants(request.resource.data);

      // Previously either participant could freely change a proposal's
      // status (accepted/declined/etc.) directly via a client write,
      // completely bypassing the server's /api/proposals/:id/accept and
      // /api/proposals/:id/decline endpoints - which are what actually
      // lock escrow and create the resulting session. Confirmed via full
      // codebase search that nothing in the client writes to an existing
      // proposal anymore (updateProposalStatusInCloud is dead code,
      // unused since the Phase 3 rewrite) - so this is safely server-only.
      allow update: if false;
      allow delete: if false;
    }

    match /sessions/{id} {
      allow read: if isParticipant(resource.data)
        && validSessionParticipants(resource.data);

      // Sessions are now created exclusively server-side, inside the
      // same escrow-locking transaction that accepts a proposal
      // (server/services/creditsService.ts) - confirmed via full
      // codebase search that the client never calls addSessionToCloud
      // anymore. Same reasoning as proposals above: server-only.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && validMessageParticipants(request.resource.data);

      allow read: if isParticipant(resource.data)
        && validMessageParticipants(resource.data);

      allow update: if isParticipant(resource.data)
        && validMessageParticipants(request.resource.data)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId;

      allow delete: if false;
    }

    match /reviews/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid;

      allow delete: if false;
    }

    match /escrowTransactions/{id} {
      allow read: if signedIn()
        && (
          resource.data.learnerId == request.auth.uid ||
          resource.data.mentorId == request.auth.uid
        );

      allow create, update, delete: if false;
    }

    match /webrtcRooms/{id} {
      allow create: if signedIn()
        && hasField(request.resource.data, "participantIds")
        && request.auth.uid in request.resource.data.participantIds;

      allow read: if isParticipant(resource.data);

      allow update: if isParticipant(resource.data)
        && hasField(request.resource.data, "participantIds")
        && request.auth.uid in request.resource.data.participantIds;

      allow delete: if false;
    }

    match /pendingPayments/{id} {
      // Only the Admin SDK (server) ever writes these - created before
      // redirecting to a payment gateway, fulfilled only by that gateway's
      // verified webhook/callback. Client can read its own for a
      // "payment pending..." status check, never write.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /transactions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{id} {
      // Only the server writes these (created directly via the Admin SDK
      // in server.ts). Client can read/query its own inbox only.
      allow read: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      allow write: if false;
    }

    match /stripeEvents/{id} {
      // Server-only idempotency ledger for Stripe webhook deliveries.
      // Never needs to be read by the client at all.
      allow read, write: if false;
    }

    /*
     * Explicitly deny all collections not declared above.
     * This prevents accidental exposure when a new collection is added
     * without corresponding security rules.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
